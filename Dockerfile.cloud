# syntax=docker/dockerfile:1
# Multi-stage Chainguard Wolfi production image for tuesday-server (GCP Cloud Run Gen2)
FROM cgr.dev/chainguard/wolfi-base:latest AS builder

RUN apk update && apk add --no-cache \
    build-base \
    curl-dev \
    git \
    ruby-3.3 \
    ruby-3.3-dev \
    postgresql-dev \
    sqlite-dev \
    yaml-dev \
    zlib-dev \
    libffi-dev \
    openssl-dev \
    tzdata \
    nodejs

WORKDIR /app
ENV RAILS_ENV=production \
    GEM_HOME="/usr/local/bundle" \
    BUNDLE_APP_CONFIG="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    PATH="/usr/local/bundle/bin:${PATH}"

COPY Gemfile* ./
COPY vendor ./vendor
RUN gem install bundler -v 2.5.20 --no-document && \
    bundle config --global silence_root_warning 1 && \
    bundle config set --local without 'development test' && \
    bundle install --local --jobs 4 || bundle install --jobs 4 --retry 3

COPY . .
RUN SECRET_KEY_BASE=dummy_key_for_build_1234567890abcdef bundle exec rails assets:precompile

# Final Hardened Runtime Stage (Non-root 65532:65532)
FROM cgr.dev/chainguard/wolfi-base:latest AS runtime

RUN apk update && apk add --no-cache \
    ruby-3.3 \
    libpq \
    sqlite-libs \
    yaml \
    tzdata \
    ca-certificates

WORKDIR /app
ENV RAILS_ENV=production \
    RAILS_LOG_TO_STDOUT=true \
    RAILS_SERVE_STATIC_FILES=true \
    GEM_HOME="/usr/local/bundle" \
    BUNDLE_APP_CONFIG="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    PATH="/usr/local/bundle/bin:${PATH}" \
    PORT=8080

COPY --from=builder --chown=65532:65532 /usr/local/bundle /usr/local/bundle
COPY --from=builder --chown=65532:65532 /app /app

USER 65532:65532
EXPOSE 8080

CMD ["sh", "-c", "mkdir -p /app/tmp/pids /app/log && bundle exec rails db:migrate db:seed && exec bundle exec puma -C config/puma.rb -p 8080"]
